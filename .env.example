# ── ActionLadder · Billiards Fight Club — Vercel environment variables ──
# Copy to your Vercel project (Settings → Environment Variables). Do NOT commit real values.
# The frontend calls /api/* (Vercel edge functions in /api).

# Stripe — use a TEST key (sk_test_…) for the demo/tournament so no real money moves.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook — only needed if you want fees automatically recorded to Supabase.
# Set this to the signing secret of your Stripe webhook endpoint (https://your-app/api/webhook).
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (Postgres) — required by every /api function (checkout reads settings & players).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Operator signup — secret key an operator must enter to create an owner account.
OPERATOR_SIGNUP_KEY=your-10-char-key

# Operator emails — comma-separated; grants "owner" server-side (also set in CONFIG.roles.operators client-side).
OPERATOR_EMAILS=osiraogene@gmail.com

# Feedback inbox — required to read submissions via GET /api/feedback (x-admin-token).
FEEDBACK_ADMIN_TOKEN=your-long-random-string
